<% @meta_title = "#{@list}" %>
<% @meta_description = @list.description %>

<div class="container-md">
  <h1><%= @list %></h1>
  <p>
    <%= @list.description %><br>
    <%= link_to @list.url, @list.url %>
  </p>
  <p class="text-muted small">
    Last synced: <%= @list.last_synced_at ? distance_of_time_in_words_to_now(@list.last_synced_at) + ' ago' : 'Never' %><br>
    <%= link_to 'JSON representation', api_v1_list_path(@list) %>
  </p>

  <% if @filters.any? %>
    <p>
      Filtered by <%= @filters.values.join(', ') %>.
      <%= link_to 'Clear filters', list_path(@list, anchor: 'list-entries') %>
    </p>
  <% end %>

  <div class="row">
    <div class="col-md-8 list-entries" id="list-entries">
      <% cache [@list, @filters, @pagy.page, @list_projects, @list_projects.map(&:project)] do %>
        <% if @list_projects.empty? %>
          <p>No projects match these filters.</p>
        <% end %>
        <% @list_projects.group_by(&:category).each do |category, entries| %>
          <% next if category == 'License' %>
          <section class="mb-4">
            <h2><%= category.presence || 'Uncategorized' %></h2>
            <% entries.group_by(&:sub_category).each do |sub_category, sub_entries| %>
              <% if sub_category.present? %>
                <h3><%= sub_category %></h3>
              <% end %>
              <ul class="list-unstyled">
                <%= render partial: 'entry', collection: sub_entries, as: :entry %>
              </ul>
            <% end %>
          </section>
        <% end %>
      <% end %>
      <%== pagy_bootstrap_nav(@pagy) if @pagy.pages && @pagy.pages > 1 %>
    </div>
    <aside class="col-md-4" aria-label="Filter projects">
      <% cache [@list, @filters, 'sidebar'] do %>
        <%= render 'filters', title: 'Programming Languages', field: 'language', counts: @list.language_breakdown.first(10) %>
        <%= render 'filters', title: 'Categories', field: 'category', counts: @list.category_counts %>
        <%= render 'filters', title: 'Subcategories', field: 'sub_category', counts: @list.sub_category_counts %>
        <%= render 'filters', title: 'Keywords', field: 'topic', counts: @list.project_topics.first(50) %>
      <% end %>
    </aside>
  </div>
</div>
